# Eval output — dev artifacts regenerated by the harnesses. Only the cited
# calibration/comparison evidence below is tracked (see font_matching.py,
# tofu.py, docs/cross-layer-architecture.md). Everything else is local-only.
scripts/eval_out/*
!scripts/eval_out/font-match-after-cohort-fix.json
!scripts/eval_out/font-match-after-font-proliferation.json
!scripts/eval_out/font-match-after-render-rung2.json
!scripts/eval_out/font-match-baseline.json
!scripts/eval_out/font-match-before-cohort-fix.json
!scripts/eval_out/font-match-before-font-proliferation.json
!scripts/eval_out/font-match-serif-features.json
!scripts/eval_out/china-street-post-w1w2w3.json
!scripts/eval_out/china-street-post-w1w2w3.png
!scripts/eval_out/china-street-pre-hardcode-removal.json
!scripts/eval_out/china-street-pre-hardcode-removal.png
!scripts/eval_out/gemini-street-post-w1w2w3.json
!scripts/eval_out/gemini-street-post-w1w2w3.png
!scripts/eval_out/gemini-street-pre-hardcode-removal.json
!scripts/eval_out/gemini-street-pre-hardcode-removal.png
