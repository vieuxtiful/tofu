# Technical paper — contains author's real name/institution; local-only.
context-aware-visual-text-rendering-via-text-over-frame-unification.docx

# User-supplied fonts are not redistributable; the server serves this dir but
# font files users drop into it are not tracked.
server/font-library/user/*.ttf
server/font-library/user/*.otf

# Server runtime data
server/uploads/
server/outputs/
server/tm_thumbs/
server/tofu.db
server/inpainting-providers.json
server/models/

# Deployment state — the bind mount docker-compose.prod.yml keeps everything
# in. This is the backup set, not the repository.
/data/

# Side-loaded language artifacts and the corpora they are built from. Both are
# large and both are reproducible: corpora.lock.json records the exact
# packages, and the build scripts are deterministic given them. That lockfile
# IS tracked, which is what makes the models' provenance answerable without
# carrying tens of MB of derived data in git.
/models/
/corpora/
*.ngram.json.gz
*.vectors.npz
*.klm