# ─── frontend build stage ─────────────────────────────────────────────────
# Self-contained on purpose. This file used to open with
#   COPY --from=tofu-frontend-build /build/dist …
# naming a stage that lives in the OTHER Dockerfile, so `docker compose build`
# failed on an unresolvable stage reference and the frontend image could never
# be produced. A stage name is scoped to the file that declares it; the two
# builds share a repository, not a namespace.
FROM node:20-slim AS frontend-build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npx tsc --noEmit && npm run build

# ─── serve stage: nginx serving the built React app ───────────────────────
FROM nginx:alpine AS frontend

COPY --from=frontend-build /build/dist /usr/share/nginx/html

## nginx:alpine's entrypoint runs envsubst over /etc/nginx/templates/*.template
## before starting. The upload cap is templated rather than literal because it
## has to agree with the server's own TOFU_MAX_UPLOAD_BYTES: nginx rejects the
## request body before FastAPI ever sees it, so a proxy cap below the app's cap
## silently overrides the configured limit, and one above it means a rejected
## upload has already crossed the wire in full.
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_MAX_BODY=2g

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1
