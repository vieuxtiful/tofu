    {
      "id": "wave-6-perspective",
      "description": "Regions seated on a plane rather than on the canvas. skew cannot express this: shear keeps opposite edges parallel, a photographed plane makes them converge. These pin the containment change — a warped region must be measured against its quad, because against its source rectangle a corner pulled outward reads as overflow on a render doing exactly what was asked.",
      "cases": [
        {
          "id": "perspective-converging",
          "image": "tests/fixtures/cjk-horizontal.png",
          "ground_truth": "tests/fixtures/cjk-horizontal.gt.json",
          "source_language": "en",
          "target_language": "en",
          "asset_class": "sign",
          "target_mode": "identity",
          "expected_regions": 2,
          "expected_outcome": "pass",
          "transform": {
            "quad": [
              [
                0.18,
                0.0
              ],
              [
                0.82,
                0.0
              ],
              [
                1.0,
                1.0
              ],
              [
                0.0,
                1.0
              ]
            ]
          },
          "note": "Top corners pulled inward: the trapezoid a sign makes when its far edge is further from the camera."
        },
        {
          "id": "perspective-outward-corners",
          "image": "tests/fixtures/cjk-horizontal.png",
          "ground_truth": "tests/fixtures/cjk-horizontal.gt.json",
          "source_language": "en",
          "target_language": "en",
          "asset_class": "sign",
          "target_mode": "identity",
          "expected_regions": 2,
          "expected_outcome": "pass",
          "transform": {
            "quad": [
              [
                -0.25,
                0.0
              ],
              [
                1.25,
                0.0
              ],
              [
                1.0,
                1.0
              ],
              [
                0.0,
                1.0
              ]
            ]
          },
          "note": "Corners pulled OUTSIDE the source box. Measured against the bbox this reports ~18% overflow and drops to review; against the quad it is correct. This is the regression the containment change prevents."
        },
        {
          "id": "perspective-degenerate-falls-back",
          "image": "tests/fixtures/cjk-horizontal.png",
          "ground_truth": "tests/fixtures/cjk-horizontal.gt.json",
          "source_language": "en",
          "target_language": "en",
          "asset_class": "sign",
          "target_mode": "identity",
          "expected_regions": 2,
          "expected_outcome": "pass",
          "transform": {
            "quad": [
              [
                0.0,
                0.0
              ],
              [
                0.5,
                0.0
              ],
              [
                1.0,
                0.0
              ],
              [
                0.0,
                1.0
              ]
            ]
          },
          "note": "Collinear corners have no invertible homography. Render and check must BOTH fall back to the affine/bbox path, or one measures something the other did not draw."
        }
      ]
    }
