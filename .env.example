## 🍢 ToFU — deployment configuration
## vieuxtiful
##
##   cp .env.example .env    then fill in the three required values
##
## server/config.py is the only module that reads any of this, and in
## production it REFUSES TO START rather than degrade quietly: a missing key
## is not a warning that scrolls past in a log, it is an open pipeline
## spending CPU and disk for anyone who finds the port.
##
## Everything below is commented with what breaks if it is wrong, because a
## deployment variable with no stated consequence is one nobody can audit.

## ── required ───────────────────────────────────────────────────────────

## The domain Caddy will obtain a certificate for. Its A/AAAA record must
## already point at this host: the ACME challenge is answered on port 80 the
## first time the stack starts.
TOFU_DOMAIN=tofu.example.com

## Comma-separated shared access keys. Each must be at least 24 characters --
## a short key is worse than no key, because it invites brute force while
## implying the endpoint is protected.
##
##   python -c "import secrets; print(secrets.token_urlsafe(32))"
##
## The demo issues ONE key to everyone; the frontend prompts for it once and
## stores it. Rotating this value invalidates every outstanding browser
## session immediately, because the session cookie carries the key itself and
## every request re-validates it.
TOFU_API_KEYS=

## development | production. Production additionally requires TOFU_API_KEYS
## and TOFU_CORS_ORIGINS to be non-empty, marks the session cookie Secure,
## and turns the rate limiter on by default.
TOFU_ENV=production

## ── set by docker-compose.prod.yml; override only if you know why ──────

## Exact frontend origin(s), comma-separated. Never '*' -- config.py refuses
## that in production because it cannot be combined with credentials, and the
## session cookie needs them.
# TOFU_CORS_ORIGINS=https://tofu.example.com

## Where uploads, renders, thumbnails and tofu.db live. Must be on the
## bind-mounted volume: everything in here is the deployment's entire state
## and a rebuild discards anything outside it.
# TOFU_DATA_DIR=/app/data

## How many reverse proxies of OUR OWN sit in front of the app. The rate
## limiter counts back from the right of X-Forwarded-For by this many entries.
## One for the Caddy in docker-compose.prod.yml. Too high and an attacker
## supplies their own address; too low and every user shares one bucket.
# TOFU_TRUSTED_PROXY_HOPS=1

## Upload cap, bytes. Must agree with the frontend proxy's client_max_body_size
## (TOFU_NGINX_MAX_BODY below): a proxy cap below this silently overrides it,
## and one above it means a body the app will reject has already crossed the
## wire in full. Default is 2 GiB.
# TOFU_MAX_UPLOAD_BYTES=2147483648
# TOFU_NGINX_MAX_BODY=2g

## Requests per window per caller. Deliberately below the 120 production
## default: this is a CPU-bound OCR pipeline, not a CRUD API. Zero disables.
# TOFU_RATE_LIMIT_REQUESTS=40
# TOFU_RATE_LIMIT_WINDOW_SECONDS=60

## Container resource ceiling. Leave the host at least one core and ~2 GB, or
## a detection burst starves Caddy of the cycles it needs to answer its own
## healthcheck and the container is restarted mid-job.
# TOFU_APP_CPUS=3.0
# TOFU_APP_MEMORY=6g

## ── optional: the language artifacts ───────────────────────────────────

## Directories holding the side-loaded n-gram and word-vector models. Both are
## created empty by the image and bind-mounted from ./models. EMPTY IS A
## SUPPORTED STATE: every provider reports not-ready, arbitration renormalizes
## the missing weight away, and the pipeline behaves exactly as it did before
## these existed.
##
## To build them, see docs/deployment.md -- one fetch, two builds, once.
# TOFU_NGRAM_DIR=/app/models/ngram
# TOFU_VECTOR_DIR=/app/models/vectors

## A KenLM binary model, if you have the C++ toolchain to build one. Takes
## precedence over the Kneser-Ney artifact when present.
# TOFU_KENLM_DIR=

## fastText language-ID model (lid.176.ftz) and an ONNX diacritic restorer.
## Neither is bundled; absent, callers get no candidate rather than a
## fabricated one.
# TOFU_FASTTEXT_MODEL=
# TOFU_DIACRITIC_MODEL=
